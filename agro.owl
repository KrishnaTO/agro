    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000390"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000584"/>
