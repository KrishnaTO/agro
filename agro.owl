        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">estructura vegetal colectiva de &amp;#243rgano (Spanish, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">POC:Maria_Alejandra_Gandolfo</oboInOwl:hasDbXref>
