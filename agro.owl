        <obo1:IAO_0000117 xml:lang="en">PERSON: Michel Dumontier</obo1:IAO_0000117>
        <obo1:IAO_0000119 xml:lang="en">https://github.com/information-artifact-ontology/IAO/issues/80</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">software method</rdfs:label>
