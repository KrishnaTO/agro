        <oboInOwl:hasExactSynonym xml:lang="en">irrigation depth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">quantity of irrigation water</oboInOwl:hasExactSynonym>
