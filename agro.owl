    <!-- http://purl.obolibrary.org/obo/PO_0025606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009002"/>
        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plant cell (PO:0009002) that is either part of a multicellular whole plant (PO:0000003) &apos;in vivo&apos; or a unicellular organism &apos;in natura&apos; (i.e. part of a natural environment).</obo1:IAO_0000115>
