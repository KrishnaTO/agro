        <obo1:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">length</obo1:IAO_0000111>
        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 1-D extent quality which is equal to the distance between two points.</obo1:IAO_0000115>
