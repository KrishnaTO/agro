        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TO_0000017"/>
        <obo1:IAO_0000115 xml:lang="en">An area density quality which inheres in above-ground crop residue by virtue of some influence exerted by the mass of above-ground crop residue applied in a given surface area.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">crop residue amount</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">crop residue area density</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000445">
