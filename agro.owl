        <oboInOwl:hasDbXref>http://www.feedipedia.org/node/275</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002170"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A compost that contains the residual compost waste generated by mushroom production. It  generally consists of a combination of wheat straw, dried blood, horse manure and ground chalk, composted together.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">spent mushroom compost</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000091"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A compost that contains the residual compost waste generated by mushroom production. It  generally consists of a combination of wheat straw, dried blood, horse manure and ground chalk, composted together.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Spent_mushroom_compost</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000111"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">Layer of material applied to the soil surface to conserve moisture, improve soil fertility, reduce weed growth, or enhance the visual appeal of the area.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">mulch</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000092"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Layer of material applied to the soil surface to conserve moisture, improve soil fertility, reduce weed growth, or enhance the visual appeal of the area.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Mulch</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000092"/>
        <obo1:IAO_0000115 xml:lang="en">A mulch where plastic sheet is used to cover soil surface. Plants grow through slits or holes in thin plastic sheeting.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">plastic mulch</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A mulch where plastic sheet is used to cover soil surface. Plants grow through slits or holes in thin plastic sheeting.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Mulch</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000092"/>
        <obo1:IAO_0000115 xml:lang="en">A mulch where textile material is used to covert the soil surface. The fabric itself can be made from synthetic or organic materials, sometimes from recycled sources.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">landscape fabric</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A mulch where textile material is used to covert the soil surface. The fabric itself can be made from synthetic or organic materials, sometimes from recycled sources.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Landscape_fabric</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000092"/>
        <obo1:IAO_0000115 xml:lang="en">A mulch where shredded or entire piece of paper or newspaper cover the soil surface.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">newspaper mulch</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">paper mulch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000096">
