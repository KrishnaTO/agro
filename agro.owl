    <!-- http://purl.obolibrary.org/obo/AGRO_00000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000416"/>
        <obo1:IAO_0000115 xml:lang="en">A mobile machine specifically designed to deliver a high tractive effort at slow speeds, and mainly used for the purposes of hauling a trailer or machinery used in agriculture or construction.</obo1:IAO_0000115>
        <dc:creator xml:lang="en">https://orcid.org/0000-0001-6284-4821</dc:creator>
        <rdfs:label xml:lang="en">tractor</rdfs:label>
    </owl:Class>
