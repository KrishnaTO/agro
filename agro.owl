        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo1:IAO_0000115 xml:lang="en">Anatomical part of the plant or animal from which a food product or its major ingredient is derived.</obo1:IAO_0000115>
