        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Sedimentary_rock#Clastic_sedimentary_rocks</oboInOwl:hasDbXref>
