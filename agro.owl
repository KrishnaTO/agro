            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A droplet formed by condensation of vapour in an atmosphere and which is sufficiently massive to overcome atmospheric resistance and fall to a planetary surface due to gravity.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">raindrop</rdfs:label>
    </owl:Class>
    


