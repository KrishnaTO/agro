                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">An agricultural environmental material that contains ground dry alfalfa.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">alfalfa meal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000090"/>
