    <!-- http://purl.obolibrary.org/obo/ENVO_00000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000068"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000309"/>
