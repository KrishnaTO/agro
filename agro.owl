                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A soil which has high mineral content and which contain no calcareous material, have less than 10% weatherable minerals its surface layer, and have less than 35% base saturation throughout its volume.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>red clay soil</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ultisol</rdfs:label>
    </owl:Class>
