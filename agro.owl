            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000111 xml:lang="en">patients section</obo1:IAO_0000111>
        <obo1:IAO_0000112 xml:lang="en">The section labelled &apos;patients&apos; in a typical scientific journal article, e.g. in Citak et al. Acta Orthop. 2013 Jun; 84(3): 326–327. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3715825/)</obo1:IAO_0000112>
        <obo1:IAO_0000115 xml:lang="en">A part of a document about the patients that participated in a study.</obo1:IAO_0000115>
        <obo1:IAO_0000117 xml:lang="en">PERSON: Bill Baumgartner</obo1:IAO_0000117>
