    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002356"/>
        <obo1:IAO_0000115>A performance status value specification designed for classifying patients 16 years of age or older by their functional impairment.</obo1:IAO_0000115>
        <rdfs:label>Karnofsky score vaue specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002989 -->

