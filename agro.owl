            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An anthropogenic terrestrial biome is a terrestrial biome which has community structures determined by human activity.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>anthrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>human biome</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anthropogenic terrestrial biome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000219"/>
