    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000096"/>
        <obo1:IAO_0000115>A season during which changes in atmospheric circulation associated with the asymmetric heating of land and sea cause moisture to be brought inland by monsoon winds, leading to increased rainfall as moisture-laden air rises  and cools over land.</obo1:IAO_0000115>
