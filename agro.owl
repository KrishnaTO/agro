        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">porci&amp;#243n de un tejido vegetal (Spanish, exact)</owl:annotatedTarget>
