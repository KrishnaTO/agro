            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">An area quality inhering in a field.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">field area</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000408"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000067"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000370"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A site within which an agricultural experimental process is conducted</obo1:IAO_0000115>
