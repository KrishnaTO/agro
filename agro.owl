        <obo1:IAO_0000115 xml:lang="en">An implement that is used during a mulch process.</obo1:IAO_0000115>
        <dc:creator xml:lang="en">https://orcid.org/0000-0001-6284-4821</dc:creator>
        <rdfs:label xml:lang="en">mulch implement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000237 -->

