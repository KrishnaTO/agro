SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002143> <http://purl.obolibrary.org/obo/PATO_0001481>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002180> (straight)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002180> "A shape quality inhering in a bearer by virtue of the bearer's being free of curves, bends, or angles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002180> "straight")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002180> <http://purl.obolibrary.org/obo/PATO_0000052>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002181> (displaced)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002181> "A positional quality inhering in a bearer by virtue the bearer's being changed in position.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002181> "displaced")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002181> <http://purl.obolibrary.org/obo/PATO_0000140>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002198> (quality of a substance)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002198> "A quality inhering in a bearer by virtue of its constitution.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002198> "quality of a substance")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002198> <http://purl.obolibrary.org/obo/PATO_0001018>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002253> (platelike)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002253> "A quality inhering in a bearer by virtue of the bearer's being roundish, flattish shape, possibly with a slightly angled edge.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0002253> "plate-like")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002253> "platelike")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002253> <http://purl.obolibrary.org/obo/PATO_0000407>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002254> (flattened)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002254> "A quality inhering in a bearer by virtue of the bearer's surface becoming more extended in a plane.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PATO_0002254> "compressed")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002254> "flattened")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002254> <http://purl.obolibrary.org/obo/PATO_0001591>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002266> (3-D shape)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002266> "A shape that inheres in a 3 dimensional entity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002266> "3-D shape")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002266> <http://purl.obolibrary.org/obo/PATO_0000052>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002299> (tubular)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002299> "A cylindrical shape that is hollow.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0002299> "tube like")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0002299> "tube-shaped")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0002299> "tubulate")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002299> "tubular")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002299> <http://purl.obolibrary.org/obo/PATO_0001873>)
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002299> <http://purl.obolibrary.org/obo/PATO_0002078>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002303> (decreased object quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002303> "A quality of an object that has a value that is decreased compared to normal or average.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002303> "decreased object quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002303> <http://purl.obolibrary.org/obo/PATO_0001241>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002305> (increased object quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002305> "A quality of an object that has a value that is increased compared to normal or average.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002305> "increased object quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002305> <http://purl.obolibrary.org/obo/PATO_0001241>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002323> (temporal distribution quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002323> "A temporal distribution pattern of process occurrences within a regulation/reference process.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002323> "temporal distribution quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002323> <http://purl.obolibrary.org/obo/PATO_0002062>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015009> (humidity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015009> "A quality inhering in air by virtue of the partial pressure exerted by the bearer's water vapour content.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015009> "humidity")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015009> <http://purl.obolibrary.org/obo/PATO_0001547>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015010> (increased humidity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015010> "An increase in humidity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PATO_0015010> "humid")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015010> "increased humidity")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015010> <http://purl.obolibrary.org/obo/PATO_0002305>)
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015010> <http://purl.obolibrary.org/obo/PATO_0015009>)

# Class: <http://purl.obolibrary.org/obo/PATO_0015021> (combustibility)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0015021> "The propensity of a material to undergo combustion. Combustion encompasses smouldering and flaming combustion. Combustibility is usually applied to solids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0015021> "combustibility")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0015021> <http://purl.obolibrary.org/obo/PATO_0001241>)

# Class: <http://purl.obolibrary.org/obo/PATO_0050000> (rate of occurence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0050000> "The number of repeated events per unit time, occurring in a repeating series. (e.g. the number of heart beats occurring over 1 minute)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0050000> "rate of occurence")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0050000> <http://purl.obolibrary.org/obo/PATO_0000161>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070060> (quality of interaction of a substance with electromagnetic radiation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070060> "A quality of a substance on which or through which electromagnetic radiation impinges or traverses with respect to radiation. This substance quality changes the quality of the incident radiation with respect to any of: intensity, direction, scatter and wavelength.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070060> "quality of interaction of a substance with electromagnetic radiation")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070060> <http://purl.obolibrary.org/obo/PATO_0002198>)

# Class: <http://purl.obolibrary.org/obo/PATO_0102001> (modifier characteristic)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0102001> "A characteristic used to describe another characteristic.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PATO_0102001> "meta characteristic")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0102001> "modifier characteristic")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0102001> <http://purl.obolibrary.org/obo/PATO_0000001>)

# Class: <http://purl.obolibrary.org/obo/PATO_0103000> (quantitative)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0103000> "A quality of an entity that can be represented numerically, including anything that can be counted, measured, or given a numerical value.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0103000> "quantitative")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0103000> <http://purl.obolibrary.org/obo/PATO_0000001>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000000> (collection of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/PCO_0000000> "Examples include: population, community, species (meaning the collection of organisms that makes up a species, not the taxonomic rank), and family.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000000> "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000000> "May be of the same or different species.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000000> "collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000000> <http://purl.obolibrary.org/obo/BFO_0000040>)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000000> <http://purl.obolibrary.org/obo/PCO_0000031>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000002> (ecological community)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000002> "A multi-species collection of organisms of at least two different species, living in a particular area. Must have at least two populations of different species as members."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PCO_0000002> "ISBN:0865423504")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PCO_0000002> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000002> "Ecological community is defined broadly here, but includes both ecological interactions (inherited from parent term community) and spatial co-existence. It may be used to describe every organisms living in an area, but is often used to refer only to organisms of a particular taxon or guild (e.g., the plant community, the insect community, the herbivore community). The word community, as it often used to describe a group of humans living together, is a type of single-species collection of organisms, not an ecological community."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000002> "ecological community"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000002> <http://purl.obolibrary.org/obo/PCO_0000029>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000029> (multi-species collection of organisms)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000029> "A collection of organisms that consists of two or more organisms from at least two species."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/PCO_0000029> "Need to add axiom to specify that it has at a mimum members of two different species, but not sure how to specify that. Can't say \"('has member' only ('member of' min 2 'species as a collection of organisms'))\"."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PCO_0000029> ""@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000029> "multi-species collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000029> <http://purl.obolibrary.org/obo/PCO_0000000>)

# Class: <http://purl.obolibrary.org/obo/PCO_0000031> (organismal entity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000031> "A material entity that is one or more organisms, viruses or viroids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000031> "organismal entity"@en)

