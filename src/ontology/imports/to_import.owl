AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0009026> "sporophyll")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0009026> <http://purl.obolibrary.org/obo/PO_0006001>)

# Class: <http://purl.obolibrary.org/obo/PO_0009027> (megasporophyll)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "APweb:Glossary") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0009027> "A structure upon which (or in the axil of which) one or more megasporangia are borne; in flowering plants, a carpel.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009027> "FNA:8e8e55b5-2c05-4089-b43c-3bcf5692c2a2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009027> "FNA:ae5076ce-3553-419a-af95-07c2062ad4e0")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009027> "FNA:c54df958-9c56-49e7-8ed8-64e36c9f42ed")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FNA:ae5076ce-3553-419a-af95-07c2062ad4e0") <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009027> "cone scale (narrow)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FNA:8e8e55b5-2c05-4089-b43c-3bcf5692c2a2") <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009027> "ovuliferous scale (narrow)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FNA:c54df958-9c56-49e7-8ed8-64e36c9f42ed") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PO_0009027> "macrosporophyll (related)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PO_0009027> <http://purl.obolibrary.org/obo/po#TraitNet>)
