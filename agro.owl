        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plant axis (PO:0025004) that is radially enlarged.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
