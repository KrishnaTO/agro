# Class: <http://purl.obolibrary.org/obo/ENVO_01001611> (thawing process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wiktionary.org/wiki/thaw") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://wikidiff.com/melt/thaw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001611> "A warming process during which the thermal energy in a portion of environmental material is sufficient to melt water-based ice or snow.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01001611> "thawing")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001611> "Note that ice or snow need not be present in the material in order for it to undergo thawing. The semantics of 'thaw' vs 'melt' are debated in fields such as permafrost geology/physics. This module is thus likely to be dynamic.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001611> "thawing process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001611> <http://purl.obolibrary.org/obo/ENVO_01001612>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001612> (material warming process)

AnnotationAssertion(Annotation(rdfs:comment "https://en.wiktionary.org/wiki/warming") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001612> "A process during which the temperature of a portion of environmental material is increased, along with the kinetic energy of its constituent molecules.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001612> "Note that melting need not involve warming (e.g. due to extreme gravitational effects). See the melting hierarchy for more terms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001612> "material warming process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001612> <http://purl.obolibrary.org/obo/ENVO_03000043>)

