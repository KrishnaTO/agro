        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mulch color</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000408"/>
        <rdfs:subClassOf>
