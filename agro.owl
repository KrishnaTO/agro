        </rdfs:subClassOf>
        <obo1:IAO_0000111 xml:lang="en">availability section</obo1:IAO_0000111>
        <obo1:IAO_0000112 xml:lang="en">The section labelled &apos;availability and requirements&apos; in a typical scientific journal article, e.g. Qi et al. BMC Bioinformatics. 2014; 15: 11. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3897912/).</obo1:IAO_0000112>
        <obo1:IAO_0000115 xml:lang="en">A part of a document about a resource described in the document, e.g. software, that describes where and/or how that resource can be obtained.</obo1:IAO_0000115>
        <obo1:IAO_0000117 xml:lang="en">PERSON: Bill Baumgartner</obo1:IAO_0000117>
        <obo1:IAO_0000118 xml:lang="en">availability</obo1:IAO_0000118>
        <obo1:IAO_0000118 xml:lang="en">availability of data</obo1:IAO_0000118>
        <obo1:IAO_0000118 xml:lang="en">data archiving</obo1:IAO_0000118>
        <obo1:IAO_0000118 xml:lang="en">data availability</obo1:IAO_0000118>
        <obo1:IAO_0000118 xml:lang="en">data availability statement</obo1:IAO_0000118>
        <obo1:IAO_0000118 xml:lang="en">data sharing statement</obo1:IAO_0000118>
        <obo1:IAO_0000233 rdf:resource="https://github.com/information-artifact-ontology/IAO/issues/183"/>
        <obo1:IAO_0000233 rdf:resource="https://github.com/information-artifact-ontology/IAO/issues/234"/>
        <rdfs:label xml:lang="en">availability section</rdfs:label>
    </owl:Class>
    


