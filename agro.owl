        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which vegetation is burned as a method of clearing the land.</obo1:IAO_0000115>
