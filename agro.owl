        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Anthropization</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000947"/>
        <obo1:IAO_0000115>An ecotone which overlaps at least one biome which supports the growth and persistence of trees and at least one that does not. Before ceasing altogether, tree growth becomes sparse and trees appear stunted as conditions become less favourable along this ecotone.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>tree line</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tree-line</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>treeline</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tree line ecotone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000953"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ecotone which overlaps at least one biome which supports the growth and persistence of trees and at least one that does not. Before ceasing altogether, tree growth becomes sparse and trees appear stunted as conditions become less favourable along this ecotone.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Tree_line</oboInOwl:hasDbXref>
    </owl:Axiom>
    


