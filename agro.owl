        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000112"/>
        <obo1:IAO_0000115>A material sample role is a specimen role borne by a material entity that is the output of a material sampling process.</obo1:IAO_0000115>
        <rdfs:label>material sample role</rdfs:label>
    </owl:Class>
    


