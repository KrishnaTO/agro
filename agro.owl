        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PO:0025606</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A native plant cell is one that is not grown or maintained in vitro, nor part of an in vitro plant structure (PO:0000004).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">native plant cell</rdfs:label>
    </owl:Class>
