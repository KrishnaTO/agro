            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A sowing device that positions seeds in the soil and then covers them. The seed drill sows the seeds at equal distances and proper depth, ensuring that the seeds get covered with soil.</obo1:IAO_0000115>
        <dc:creator xml:lang="en">https://orcid.org/0000-0001-6284-4821</dc:creator>
