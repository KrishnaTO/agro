SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000467> <http://purl.obolibrary.org/obo/ENVO_00000070>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000468> (fence)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fence") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000468> "A fence is a constructed barrier which is  generally of lighter construction than a wall and used to provide visual sectioning of spaces.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000468> "fence")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000468> <http://purl.obolibrary.org/obo/ENVO_01000467>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000480> (glass)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Glass") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000480> "Glass is an amorphous (non-crystalline) solid which is often transparent.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000480> "This class refers to all forms of glass. For the familiar form present in window panes and drinking glasses, consider silica-based glass.")
