AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002068> "A spatial pattern inhering in a bearer by virtue of the bearer's exhibiting a layered configuration.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002068> "stratified")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002068> <http://purl.obolibrary.org/obo/PATO_0002067>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002078> (hollow)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002078> "A quality inhering in a bearer by virtue of the bearer's having an empty space or cavity within.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002078> "hollow")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002078> <http://purl.obolibrary.org/obo/PATO_0002014>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002124> (laminar)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002124> "A quality inhering in a bearer by virtue of the bearer's processing the form of a thin plate sheet or layer.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002124> "laminar")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002124> <http://purl.obolibrary.org/obo/PATO_0000141>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002143> (sloped downward)

