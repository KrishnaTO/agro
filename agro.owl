    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00002039"/>
