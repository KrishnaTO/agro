SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000048> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_00000015>))
