            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">Tool for loosening compacted soil layers 12 to 16 inches (30 to 40 cm) deep and still maintain high surface residue levels.</obo1:IAO_0000115>
        <dc:creator xml:lang="en">https://orcid.org/0000-0001-6284-4821</dc:creator>
