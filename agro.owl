        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
        <rdfs:label xml:lang="en">land clearing date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which vegetation is cut down and burned as a method of clearing the land for cultivation.</obo1:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
        <oboInOwl:hasExactSynonym xml:lang="en">S&amp;B</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">fire-fallow cultivation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">slash-and-burn</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">slash-and-burn process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000525"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A process in which vegetation is cut down and burned as a method of clearing the land for cultivation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.rainforestsaver.org/what-slash-and-burn-farming</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which vegetation is cut down and removed from the land.</obo1:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
        <rdfs:label xml:lang="en">slash-and-remove process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which rocks are crushed to clear the land.</obo1:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
        <rdfs:label xml:lang="en">rock crushing process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which vegetation is cut down, grinded and mulched on the cleared land.</obo1:IAO_0000115>
