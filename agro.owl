    <!-- http://purl.obolibrary.org/obo/AGRO_00010156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00010156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000077"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000584"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">Fence established by planting large cuttings, that easily produce roots and on which several strings of wire are attached with the obvious purpose of keeping livestock in or out.</obo1:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-3985-4911"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-12-24T00:21:23Z</dc:date>
        <oboInOwl:hasExactSynonym>fenceline planting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">live fence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00010156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Fence established by planting large cuttings, that easily produce roots and on which several strings of wire are attached with the obvious purpose of keeping livestock in or out.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>&quot;Harvey, C.A., Villanueva, C., Villacís, J., Chacón, M., Muñoz, D., López, M., Ibrahim, M., Gómez, R., Taylor, R., Martinez, J. and Navas, A., 2005. Contribution of live fences to the ecological integrity of agricultural landscapes. Agriculture, ecosystems &amp; environment, 111(1-4), pp.200-230. ecological integrity of agricultural landscapes&quot;</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00010157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00010157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00010156"/>
