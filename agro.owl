            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>An area of a planet&apos;s surface which is primarily covered by a shrubs, young trees, or stunted trees.. The surfaces of this area are in contact with an atmospheric column extending from the planetary boundary layer to the planet&apos;s exosphere with little to no physical obstruction.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>area of shrub</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">area of scrub</rdfs:label>
    </owl:Class>
