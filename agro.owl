    <!-- http://purl.obolibrary.org/obo/ENVO_01000829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000828"/>
        <obo1:IAO_0000115>Air which has a partial pressure of water vapour equal or near equal to its equilibrium vapor pressure at a given temperature.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>water-vapour-saturated air</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>wet air</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">water vapour saturated air</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000830 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000703"/>
        <rdfs:subClassOf>
