        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000006"/>
        <obo1:IAO_0000115 xml:lang="en">Application of water below full crop requirements compared to a control of conventional irrigation.</obo1:IAO_0000115>
