    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An harvest process in which the mature part of the crop is cut.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.knowledgebank.irri.org/postproductioncourse/index.php/what-is-harvesting/cutting-the-rice-crop</oboInOwl:hasDbXref>
    </owl:Axiom>
    


