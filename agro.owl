                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0000915"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000092"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000915"/>
        <obo1:IAO_0000115 xml:lang="en">A thickness quality which is equal to the distance betwenn the top of the mulch layer to the top of the soil layer.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">mulch thickness</rdfs:label>
    </owl:Class>
    


