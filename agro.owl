        <oboInOwl:hasDbXref>https://naldc.nal.usda.gov/download/3268/PDF</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000264"/>
        <obo1:IAO_0000115 xml:lang="en">Measure the lignin concentration with the permanganate method.</obo1:IAO_0000115>
