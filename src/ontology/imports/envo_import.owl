AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00000340> "In general, sand grains are larger than those of silt, but finer than those of gravel."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000340> "particle of sand"@en)
