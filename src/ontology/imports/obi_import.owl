AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0000744> "material sampling process")
EquivalentClasses(<http://purl.obolibrary.org/obo/OBI_0000744> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/OBI_0000659> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000293> <http://purl.obolibrary.org/obo/BFO_0000040>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000299> <http://purl.obolibrary.org/obo/OBI_0000747>)))
