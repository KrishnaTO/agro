            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">An area quality inhering in a farm.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">farm area</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001323"/>
