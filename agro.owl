    <!-- http://purl.obolibrary.org/obo/PO_0009002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
