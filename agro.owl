        <obo1:IAO_0000115>An objective specification which is fulfilled by the provision of some training.</obo1:IAO_0000115>
        <rdfs:label>training objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000963 -->

