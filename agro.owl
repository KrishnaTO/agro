        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A biological pest control process in which suitable habitat or food are provided to the naturally occurring population of organisms that help to manage pests.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Biological_pest_control#Importation</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000108 -->

