        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000476"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An agricultural experiment running over decadal time periods.</owl:annotatedTarget>
        <oboInOwl:source>Richard Ostler</oboInOwl:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000477">
