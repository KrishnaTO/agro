            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>An ecosystem which is determined by communities of plants with a tree growth form and in which members of those communities form continuous or discontinuous regions of canopy cover.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">forest ecosystem</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001243"/>
