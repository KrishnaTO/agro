        <rdfs:label xml:lang="en">planetary subsurface zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000947 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000947">
