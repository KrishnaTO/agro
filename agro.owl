        <rdfs:label xml:lang="en">lignin concentration measurement protocol using acid detergent fiber</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Measure the lignin concentration following the acid detergent fiber method</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/pubmed/12564795</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000264"/>
        <obo1:IAO_0000115 xml:lang="en">Measure the lignin concentration with the thioglycolic acid method.</obo1:IAO_0000115>
