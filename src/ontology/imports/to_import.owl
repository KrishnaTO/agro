AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009012> "PO_GIT:185")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009012> "TAIR:0000205")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0009012> "plant growth and development stage (exact)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAIR:0000205") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PO_0009012> "Arabidopsis growth (related)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PO_0009012> <http://purl.obolibrary.org/obo/po#TraitNet>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0009012> "Refers to GO:0032502 'developmental process', which includes growth, differentiation, and senescence, and BFO:0000003 'ocurrent'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0009012> "plant structure development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0009012> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <http://purl.obolibrary.org/obo/PO_0009013> (portion of meristem tissue)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "APweb:Glossary") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Gramene:Pankaj_Jaiswal") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0009013> "A portion of plant tissue (PO:0009007) in which plant cells (PO:0009002) have retained their embryonic characteristics, or have reverted to them secondarily, and that divide to produce new cells that can undergo differentiation to form mature tissues, i.e. they have a capacity for morphogenesis and growth.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0009013> "PO_GIT:472")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0009013> "meristem (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0009013> "meristematic tissue (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PO_0009013> <http://purl.obolibrary.org/obo/po#TraitNet>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0009013> "portion of meristem tissue")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0009013> <http://purl.obolibrary.org/obo/PO_0009007>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0009013> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/PO_0004010>))

