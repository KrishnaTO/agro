        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">植物組織の一部 (Japanese, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NIG:Yukiko_Yamazaki</oboInOwl:hasDbXref>
