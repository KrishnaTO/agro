            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A process whereby a volume of liquid moves due to a disequilibrium of physical forces.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">mass liquid flow</rdfs:label>
    </owl:Class>
