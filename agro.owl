        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A planned process in which a layer of material is apply to the soil surface to conserve moisture, improve soil fertility, reduce pests population and enhance the visual appeal of the area.</obo1:IAO_0000115>
        <dc:creator xml:lang="en">https://orcid.org/0000-0001-6284-4821</dc:creator>
