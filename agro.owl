    <!-- http://purl.obolibrary.org/obo/ENVO_01001244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001790"/>
        <obo1:IAO_0000115>An ecosystem which 1) is determined by communities of annual crops, perennial woody crops, or by actively tilled land, 2) is primarily used for agricultural activity, and 3) contains no village or larger human settlement.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">cropland ecosystem</rdfs:label>
    </owl:Class>
