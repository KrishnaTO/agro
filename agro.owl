        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The characteristic reproductive structure of angiosperms. May have as part one or more petals, sepals or tepals. May contain one or more pistillode (PO:0009078), staminode (PO:0009077) or other aborted organs that don&apos;t show up in mature form.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flower</rdfs:label>
    </owl:Class>
