        <obo1:IAO_0000116 xml:lang="en">Alan Ruttenberg 1/3/2012 - Provisional id, see issue at https://github.com/information-artifact-ontology/IAO/issues/130&amp;thanks=130&amp;ts=1325636583</obo1:IAO_0000116>
        <obo1:IAO_0000117 xml:lang="en">Person:Alan Ruttenberg</obo1:IAO_0000117>
        <obo1:IAO_0000117 xml:lang="en">Person:Chris Stoeckart</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">email address</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000442 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50906"/>
        <obo1:IAO_0000111 xml:lang="en">author role</obo1:IAO_0000111>
        <obo1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo1:IAO_0000115 xml:lang="en">A role inhering in a person or organization that is realized when the bearer participates in the work which is the basis of the document, in the writing of the document, and signs it with their name.</obo1:IAO_0000115>
        <obo1:IAO_0000117 xml:lang="en">PERSON: Alan Ruttenberg</obo1:IAO_0000117>
