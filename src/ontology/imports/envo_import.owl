# Class: <http://purl.obolibrary.org/obo/ENVO_01000798> (plasma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.merriam-webster.com/dictionary/plasma") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Plasma_%28physics%29") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000798> "A material entity which is composed of a volume of unbound positive and negative particles in roughly equal numbers, conducts electricity, and possesses internal magnetic fields.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000798> "An NTR for `quality of a plasma` has been posted on the PATO tracker: https://github.com/pato-ontology/pato/issues/88")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000798> "plasma"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000798> <http://purl.obolibrary.org/obo/ENVO_02000140>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000799> (astronomical body)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Astronomical_object") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000799> "An object which is naturally occuring, bound together by gravitational or electromagnetic forces, and surrounded by space.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000799> "celestial body")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000799> <http://purl.obolibrary.org/obo/envo#envoAstro>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000799> "Astronomical bodies are usually cohesive, thus the use of the term 'object' sensu BFO 'object'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000799> "astronomical body"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000799> <http://purl.obolibrary.org/obo/ENVO_01000804>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000800> (planet)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://solarsystem.nasa.gov/planets/whatisaplanet") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Planet") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000800> "A planet is an astronomical body orbiting a star or stellar remnant that is massive enough to be rounded by its own gravity, is not massive enough to cause thermonuclear fusion, and has cleared its neighbouring region of planetesimals.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000800> <http://purl.obolibrary.org/obo/envo#envoAstro>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000800> <http://purl.obolibrary.org/obo/envo#envoPolar>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000800> "Considerable debate on the definition of planet exists.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000800> "planet"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000800> <http://purl.obolibrary.org/obo/ENVO_01000799>)

