    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo1:IAO_0000115 xml:lang="en">A planned process in which the harvest is stored.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">storage process</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">agricultural product storage process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000467 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000025"/>
        <obo1:IAO_0000115 xml:lang="en">An harvest process in which the mature part of the crop is cut.</obo1:IAO_0000115>
