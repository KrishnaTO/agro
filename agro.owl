                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GAZ_00000448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo1:IAO_0000115>A textual entity that is used as directive to deliver something to a person, or organization</obo1:IAO_0000115>
        <obo1:IAO_0000116>2010-05-24 Alan Ruttenberg. Use label for the string representation. See issue https://github.com/information-artifact-ontology/IAO/issues/59</obo1:IAO_0000116>
        <rdfs:label xml:lang="en">postal address</rdfs:label>
    </owl:Class>
    


