                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000024"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000058"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_01000000"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">An application method in which the material entity is placed in the reduced soil layer.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">subsurface placement</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">The material entity is often compacted into pellet or briquette before being placed into the soil.</rdfs:comment>
        <rdfs:comment xml:lang="en">The reduction soil layer is usually localized around 5 to 10 cm under the soil surface.</rdfs:comment>
        <rdfs:comment xml:lang="en">This application method is often used in paddy field.</rdfs:comment>
        <rdfs:label xml:lang="en">deep placement</rdfs:label>
    </owl:Class>
    


