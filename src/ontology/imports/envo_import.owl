SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00010505> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01000797>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00010505> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000060> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002219> <http://purl.obolibrary.org/obo/ENVO_01000797>))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00010505> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001332>))

