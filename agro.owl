        <obo1:IAO_0000115 xml:lang="en">A localized irrigation process in which water is conveyed under pressure through a pipe system where it drips slowly onto the soil close to the plants.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">drip irrigation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">micro irrigation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">trickle irrigation</oboInOwl:hasExactSynonym>
