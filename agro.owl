    <!-- http://purl.obolibrary.org/obo/FOODON_03400105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo1:IAO_0000115 xml:lang="en">Seasoned product that contains multiple ingredients and that is used in limited amounts to accompany other foods; excludes flavors, spices and herbs.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">dressing, condiment, gravy or sauce (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400133"/>
        <obo1:IAO_0000115 xml:lang="en">Aromatic or pungent plant product used whole or ground as a seasoning in food products.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">spice or herb (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo1:IAO_0000115 xml:lang="en">Any form of whole or milled grain, prepared grain product or starch containing product derived from non-grain sources. [FDA CFSAN 1995]</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">grain or starch product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo1:IAO_0000115 xml:lang="en">Product that imparts or helps to impart a taste or aroma in food (21 CFR.170.3(n)(26). [FDA CFSAN 1995]</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">flavoring or seasoning (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400125"/>
        <obo1:IAO_0000115 xml:lang="en">Food product prepared by milling a grain or by producing flour, meal or grits from a non-grain source such as beans, starchy roots or tubers. Refined starch is indexed under *REFINED OR PARTIALLY REFINED FOOD PRODUCT*.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">milled grain or starch product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400257"/>
        <obo1:IAO_0000115 xml:lang="en">Vegetables in all forms except where a use-related product type descriptior (such as *PREPARED FOOD PRODUCT* or *SNACK FOOD*) takes precedence.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">vegetable or vegetable product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400105"/>
        <obo1:IAO_0000115 xml:lang="en">Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavors of other foods; includes catsup, relish, prepared mustard, prepared horseradish, and condiment sauces.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">condiment or relish (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo1:IAO_0000115 xml:lang="en">Fruits and vegetables in all forms. [FDA CFSAN 1995]</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">fruit or vegetable product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400260">
