        <oboInOwl:hasExactSynonym xml:lang="en">desuckering process</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Which suckers are removed depends on the criteria set by the agent of the desuckering process.</rdfs:comment>
        <rdfs:label xml:lang="en">desuckering</rdfs:label>
    </owl:Class>
    


