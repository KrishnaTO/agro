# Class: <http://purl.obolibrary.org/obo/ENVO_01003008> (percolation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Percolation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003008> "A material transport process during which a fluid is filtered through porous soild or semi-solid materials."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003008> "This is not necessarily advective, and the properties of and processes participated in by the fluid may change."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003008> "percolation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003008> <http://purl.obolibrary.org/obo/ENVO_03000010>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003008> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_02000140>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003008> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00010483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0000984>))))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003009> (drainage process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Drainage>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003009> "A material transport process during which a liquid which is not absorbed or otherwise held in place by a material is transported away from its location."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003009> "Drainage may occur due to natural (e.g. gravitational) or artificial processes (e.g. pumping)"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003009> "drainage process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003009> <http://purl.obolibrary.org/obo/ENVO_03000010>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003009> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000066> <http://purl.obolibrary.org/obo/ENVO_00010483>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003009> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000815>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003010> (convective transport process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Convection>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003010> "A material transport process which arises spontaneously due to physical heterogeneities in a portion of a material and forces which act throughout its volume."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Convection>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003010> "Most commonly, convective flows are generated by heterogeneities in density or the effects of gravity. When the cause of the convection is unspecified, convection due to the effects of thermal expansion and buoyancy can be assumed. Convection frequently occurs in fluids, but may also take place in soft solids or mixtures where particles can flow."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003010> "convective transport process"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01003010> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_03000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/ENVO_01003011>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003010> <http://purl.obolibrary.org/obo/ENVO_03000010>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/ENVO_01003011>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003011> (convective)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Convection>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003011> "A physical quality of a process which is characteristic of processes that transport material within a volume due to the combined effects of material property heterogeneity and body forces across that volume."@en)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://purl.obolibrary.org/obo/ENVO_01003011> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003011> "convective"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003011> <http://purl.obolibrary.org/obo/PATO_0002062>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01003012> (advective)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Advection>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003012> "A physical quality of a process which is characteristic of process that transport material without, themselves, changing the qualities of those materials or the processes that are unfolding within them."@en)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://purl.obolibrary.org/obo/ENVO_01003012> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003012> "advective"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003012> <http://purl.obolibrary.org/obo/PATO_0002062>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01003013> (material diffusion process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Diffusion>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003013> "A material transport process during which material moves from a region of higher concentration to a region of lower concentration."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01003013> "diffusion"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003013> "Diffusion is also applied to the movement of energy, thus the more specific label. This class will be repositioned (but with the core of its definition intact) if we include other forms of diffusion in ENVO."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003013> "material diffusion process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003013> <http://purl.obolibrary.org/obo/ENVO_03000010>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01003014> (irradiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Irradiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003014> "An energy transfer process during which a material entity receives energy through radiation."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Irradiation>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003014> "The term irradiation usually - but not always - excludes the exposure to non-ionizing radiation, such as infrared, visible light, microwaves from cellular phones or electromagnetic waves emitted by radio and TV receivers and power supplies. Please use the subclasses of this term for precision."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003014> "irradiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003014> <http://purl.obolibrary.org/obo/ENVO_01001852>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003014> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_00010504>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003014> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002427> <http://purl.obolibrary.org/obo/ENVO_01001023>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003016> (irradiation by non-ionizing radiation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003016> "Irradiation during which a material entity receives energy through non-ionizing radiation."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01003016> "irradiation by non-ionising radiation"@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Irradiation>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003016> "Note that some forms of ultraviolet radiation can be ionising, thus it is not included in the logical axioms of this class."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003016> "irradiation by non-ionizing radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003016> <http://purl.obolibrary.org/obo/ENVO_01003014>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003016> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_01001861> <http://purl.obolibrary.org/obo/ENVO_01001864> <http://purl.obolibrary.org/obo/ENVO_21001212> <http://purl.obolibrary.org/obo/ENVO_21001213> <http://purl.obolibrary.org/obo/ENVO_21001214> <http://purl.obolibrary.org/obo/ENVO_21001215>)))

