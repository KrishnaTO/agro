# Class: <http://purl.obolibrary.org/obo/ENVO_06105239> (exchangeable calcium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eco-gem.com/soil-science-available-calcium-cation-exchange-complex/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105239> "A calcium ion which is capable of ion exchange."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000232> <http://purl.obolibrary.org/obo/ENVO_06105239> "This class will be moved under Ca2+ once it has been imported from CHEBI"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105239> "exchangeable Ca2+")
