                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">Dry, inert powder made from blood. Blood usually comes from cattle or hogs as a slaughterhouse by-product.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">blood meal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Dry, inert powder made from blood. Blood usually comes from cattle or hogs as a slaughterhouse by-product.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Blood_meal</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000087 -->

