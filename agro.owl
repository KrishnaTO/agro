                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>An envirommental system which bridges two or more biomes and which includes ecological communities which blend these biomes&apos; phylogenetic and phenotypic compositions.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">ecotone</rdfs:label>
