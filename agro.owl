        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An area of a planet&apos;s surface which is primarily covered by a shrubs, young trees, or stunted trees.. The surfaces of this area are in contact with an atmospheric column extending from the planetary boundary layer to the planet&apos;s exosphere with little to no physical obstruction.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://dx.doi.org/10.1016/j.rse.2015.07.014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Exosphere</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Planetary_surface</oboInOwl:hasDbXref>
