    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000109"/>
