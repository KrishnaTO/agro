                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A part of an astronomical body which is primarily composed of a continuous volume of gaseous or aerosolised material held in shape by one or more environmental processes.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">aeroform</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000768 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001243"/>
        <obo1:IAO_0000115>Forest which originally covered a region before changes in the environment brought about by people. (Source: PHC)</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">primary forest</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
