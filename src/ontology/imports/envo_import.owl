AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/w/index.php?title=Surface_runoff&oldid=1053883452>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://pesticidestewardship.org/water/runoff/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.merriam-webster.com/dictionary/runoff>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105211> "Liquid water which 1) flows over land and 2) is not absorbed or retained by the materials if flows over or through."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105211> "overland flow"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105211> "surface runoff"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_06105211> <http://purl.obolibrary.org/obo/ENVO_03605019>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105211> "Runoff often gathers debris and solutes from the materials it flows over or through, and often flows into a water body."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105211> "runoff"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105211> <http://purl.obolibrary.org/obo/ENVO_00002006>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105211> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_00002001> <http://purl.obolibrary.org/obo/ENVO_01000600> <http://purl.obolibrary.org/obo/ENVO_01000722> <http://purl.obolibrary.org/obo/ENVO_01001267>)))

