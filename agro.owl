        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000583"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Woody species planted and left to grow during fallow.</owl:annotatedTarget>
        <dc:source>http://www.fao.org/forestry/agroforestry/89998/en/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00002071"/>
        <rdfs:subClassOf>
            <owl:Restriction>
