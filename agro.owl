        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In ferns and many monocots, a rhizome is a primary axis (stem), while in other species, it is a branch. Usually produces scale-like leaves.</rdfs:comment>
