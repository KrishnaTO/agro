        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A planned process in which trees, stumps, brush, stones and other obstacles are removed from an area with the intention of creating a potential use for agricultural purposes.</obo1:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
        <rdfs:label xml:lang="en">land clearing process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A planned process in which trees, stumps, brush, stones and other obstacles are removed from an area with the intention of creating a potential use for agricultural purposes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.evansly.co/documents/CLEAR%20AND%20GRUBBING/870218-41_land_clearing.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www2.gnb.ca/content/gnb/en/departments/10/agriculture/content/crops/organic_production/land_development/land_clearing.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001351"/>
        <obo1:IAO_0000115 xml:lang="en">An area density quality which inheres in animal manure by virtue of some influence exerted by the mass of animal manure applied in a given surface area.</obo1:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8213-0815"/>
        <dc:description xml:lang="en">An area density quality which inheres in animal manure by virtue of some influence exerted by the mass of animal manure applied in a given surface area.</dc:description>
        <oboInOwl:hasExactSynonym xml:lang="en">amount of animal manure applied</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">animal manure area density</rdfs:label>
    </owl:Class>
    


