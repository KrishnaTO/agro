SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000057> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_01000204> <http://purl.obolibrary.org/obo/ENVO_01000205>)))

