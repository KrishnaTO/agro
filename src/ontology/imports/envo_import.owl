AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_00002267> "This will become a defined class, with subclasses added through inference based on material having a 'waste role' and being associated with industrial entities.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_00002267> "industrial waste")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00002267> "industrial waste material")
