        <obo1:IAO_0000111 xml:lang="en">generated ontology module</obo1:IAO_0000111>
        <obo1:IAO_0000115 xml:lang="en">An ontology module that is automatically generated, for example via a SPARQL query or via template and a CSV.</obo1:IAO_0000115>
        <obo1:IAO_0000116 xml:lang="en">TODO: Add axioms (using PROV-O?) that indicate this is the output-of some reasoning process</obo1:IAO_0000116>
        <rdfs:label xml:lang="en">generated ontology module</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_8000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_8000015">
