                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000800"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A planetary structural layer is laminar part of a terrestrial planet or other rocky body large enough to have differentiation by density. Planetary layers have differing physicochemical properties and composition.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">planetary structural layer</rdfs:label>
    </owl:Class>
    


