    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000513"/>
        <obo1:IAO_0000115 xml:lang="en">A process in which rocks are removed to clear the land.</obo1:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-6284-4821"/>
