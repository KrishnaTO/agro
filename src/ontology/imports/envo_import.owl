# Class: <http://purl.obolibrary.org/obo/ENVO_06105272> (loamy sand)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105272> "Soil which is primarily composed of sand with silt and clay in progressively smaller proportions."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105272> "Some authorities consider this a soil type, composed of 70-86% of sand, 0-30% of silt and 0-15% of clay. Others consider this a soil material that contains at the upper limit 85 to 90% sand, and the percentage of silt plus 1.5 times the percentage of clay is not less than 15, at the lower limit it contains not less than 70 to 85% sand, and the percentage of silt plus twice the percentage of clay does not exceed 30."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105272> "loamy sand"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105272> <http://purl.obolibrary.org/obo/ENVO_01000017>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105272> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_00002258>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105273> (fine sand)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105273> "Sand which is composed primarily of fine particles."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105273> "Thresholds for what particle size is considered \"fine\" vary by region and authority, as well as the tolerance for proportions of other particle sizes."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105273> "fine sand"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105273> <http://purl.obolibrary.org/obo/ENVO_01000017>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105274> (sandy loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105274> "Loam which has a high proportion of sand in its composition."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105274> "Some authorities consider sandy loam to be a soil composed of 50-70% sand, 0-50% silt, and 0-20% clay. Others, a soil material that contains either 20% or less clay, with a percentage of silt plus twice the percentage of clay that exceeds 30, and 52% or more sand; or less than 7% clay, less than 50% silt, and between 43% and 52% sand."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105274> "sandy loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105274> <http://purl.obolibrary.org/obo/ENVO_00002258>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105274> <http://purl.obolibrary.org/obo/ENVO_00003082>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105274> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_01000017>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105275> (silty loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105275> "Loam which has a high proportion of silt in its composition."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105275> "Some authorities consider silt loam to be a soil composed of 20-50% of sand, 74-88% silt and 0-27% of clay."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105275> "USDA textural classes of soils")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105275> "silty loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105275> <http://purl.obolibrary.org/obo/ENVO_00002258>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105275> <http://purl.obolibrary.org/obo/ENVO_00003082>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105275> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_01000016>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105276> (sandy clay loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105276> "Clay loam which has a high proportion of sand in its composition."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105276> "Some authorities consider sandy clay loam to be a soil composed of 45-80% sand, 0-28% silt, and 20-35% clay."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105276> "sandy clay loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105276> <http://purl.obolibrary.org/obo/ENVO_06105277>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105276> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_01000017>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105277> (clay loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105277> "Loam which has a high proportion of clay in its composition."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_06105277> "Interestingly, some instances of this class may not actually conform to the definition of loam, by having roughly unequal proportions of sand and silt and quite a large proportion of clay."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105277> "Some authorities consider clay loam to be a soil composed of 20-45% sand, 15-52% silt, and 27 to 40% clay."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105277> "clay loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105277> <http://purl.obolibrary.org/obo/ENVO_00002258>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105277> <http://purl.obolibrary.org/obo/ENVO_00003082>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105277> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_00002982>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105278> (silty clay loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105278> "Clay loam which has a high proportion of silt in its composition."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105278> "Some authorities consider silty clay loam to be a soil composed of 0-20% of sand, 40-73 of silt and 27-40% of clay."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105278> "silty clay loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105278> <http://purl.obolibrary.org/obo/ENVO_06105277>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105278> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_01000016>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105279> (sandy clay)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105279> "Clay which has a high proportion of sand in its composition."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_06105279> "If this is a soil (in which case the differntia must be made clear) it should be moved (or a new class created) and labelled 'sandy clay soil'."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105279> "Some authorities consider sandy clay to be a soil composed of 45-65% of sand, 0-20% of silt and 35-55% of clay. If the proportion of sand exceeds that of clay, it is unclear whether this is still considered clay (due to other properties) or whether a new class \"clay sand\" should be created."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105279> "sandy clay"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105279> <http://purl.obolibrary.org/obo/ENVO_00002982>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105279> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01000017>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105280> (silty clay)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105280> "Clay which has a high proportion of silt in its composition."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_06105280> "If this is a soil (in which case the differntia must be made clear) it should be moved (or a new class created) and labelled 'silty clay soil'."@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105280> "Some authorities consider this a soil composed of 0-20% of sand, 40-60% of silt and 40-60% of clay. If the proportion of silt exceeds that of clay, it is unclear whether this is still considered clay (due to other properties) or whether a new class \"clay silt\" should be created."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105280> "silty clay"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105280> <http://purl.obolibrary.org/obo/ENVO_00002982>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105280> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01000016>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105300> (wastewater treatment process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105300> "A recycling process during which wastewater is treated"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105300> "wastewater treatment process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105300> <http://purl.obolibrary.org/obo/ENVO_01000741>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105301> (desalination process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105301> "A recycling process during which the dissolved mineral salts in water are removed"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105301> "desalination process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105301> <http://purl.obolibrary.org/obo/ENVO_01000741>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105302> (field capacity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Field_capacity>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.civilengineeringterms.com/engineering-hydrology/field-capacity-permanent-wilting-point-available-water/>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105302> "A concentration of liquid water in soil arrived at after water which is not retained by the soil has drained away."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105302> "drained upper limit"@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Field_capacity>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105302> "The determination of field capacity is variable and multiple methods to do so exist. Even in a given soil, the value of field capacity is variable, but serves as a useful measure of its water-holding capacity. Field capacity is often characterized by measuring water content after wetting a soil profile, covering it (to prevent evaporation) and monitoring the change soil moisture in the profile. Water content when the rate of change is relatively small is indicative of when drainage ceases and is called field capacity, it is also termed drained upper limit (DUL). This measure of field capacity is well-correlated with field capacity determined by applying −33 kPa (or −0.33 bar) of hydraulic head or suction pressure (less in sandy soils) to a portion of soil  and subsequently measuring the bulk water content it retains.Field capacity is usually naturally arrived at 2–3 days after rain or irrigation in pervious soils of uniform structure and texture."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105302> "field capacity"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105302> <http://purl.obolibrary.org/obo/ENVO_09000026>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105303> (permanent wilting point)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.civilengineeringterms.com/engineering-hydrology/field-capacity-permanent-wilting-point-available-water/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Permanent_wilting_point") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105303> "A concentration of liquid water in soil at or below which a plant will wilt and no longer recover its turgidity when placed in a water saturated atmosphere."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105303> "PWP"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105303> "wilting point"@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Permanent_wilting_point>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105303> "The type of plant and soil are sources of variation for values of this concentration. The physical definition of the wilting point is conventionally measured as the water content at −1,500 kPa (−15 bar) of suction pressure, or negative hydraulic head."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105303> "permanent wilting point"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105303> <http://purl.obolibrary.org/obo/ENVO_09000026>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105304> (water-holding capacity of soil)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.canr.msu.edu/news/why_is_soil_water_holding_capacity_important>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105304> "Water-holding capacity which inheres in some soil."@en)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://purl.obolibrary.org/obo/ENVO_06105304> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105304> "soil water-holding capacity"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105304> "water-holding capacity of soil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105304> <http://purl.obolibrary.org/obo/ENVO_01003001>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105304> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/ENVO_00001998>))

