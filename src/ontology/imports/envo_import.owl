AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001244> "cropland ecosystem"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001244> <http://purl.obolibrary.org/obo/ENVO_01001790>)
