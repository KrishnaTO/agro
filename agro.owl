        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001478"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
