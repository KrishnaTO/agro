        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Press_cake</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00002039"/>
