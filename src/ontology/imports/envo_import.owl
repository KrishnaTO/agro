SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000814> <http://purl.obolibrary.org/obo/ENVO_00010483>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000814> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001546>))

