AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000801> "Add qualities such as spherical. Request NTRs if not available in PATO.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000801> <http://purl.obolibrary.org/obo/envo#envoAstro>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000801> <http://purl.obolibrary.org/obo/envo#envoPolar>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000801> "star"@en)
