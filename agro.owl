        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000021"/>
        <obo1:IAO_0000115 xml:lang="en">A mechanical pest control process in which pests are kept away.</obo1:IAO_0000115>
