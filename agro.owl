     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/agro-edit.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/agro/releases/2022-11-02/agro.owl"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000416"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/AGRO_00002062"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/AGRO_00002071"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/PO_0025131"/>
        <obo1:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <dc:contributor>Céline Aubert</dc:contributor>
        <dc:contributor>Marié-Angélique Laporte</dc:contributor>
        <dc:contributor>Pier Luigi Buttigieg</dc:contributor>
        <dc:description xml:lang="en">AgrO is an ontlogy for representing agronomic practices, techniques, variables and related entities</dc:description>
        <dc:title xml:lang="en">Agronomy Ontology</dc:title>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">The Agronomy Ontology by CGIAR is licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).</rdfs:comment>
    </owl:Ontology>
    


