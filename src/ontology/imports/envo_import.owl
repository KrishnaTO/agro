AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0000924> "embryonic ectoderm")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000924> "ectoderm")
