            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">A planned process in which unwanted organisms are controlled.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">pest control</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pest control process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000023"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
