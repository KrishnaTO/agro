        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A determinate reproductive shoot system (PO:0025082) that has as part at least one carpel (PO:0009030) or at least one stamen (PO:0009029) and does not contain any other determinate shoot system (PO:0009006) as a part.</obo1:IAO_0000115>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PO:0004541</oboInOwl:hasAlternativeId>
