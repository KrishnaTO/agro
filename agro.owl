        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0030111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kürbisfrucht (exact, German)</owl:annotatedTarget>
