        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400361"/>
        <obo1:IAO_0000115 xml:lang="en">Food group having common consumption, functional or manufacturing characteristics, e.g. *FRUIT OR VEGETABLE PRODUCT*, *DAIRY PRODUCT*, *CONFECTIONARY*, *PREPARED FOOD PRODUCT*, etc. [FDA CFSAN 1995]</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">USA agency food product type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400306">
