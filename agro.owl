        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001690"/>
        <obo1:IAO_0000115>A droplet is a small column of liquid, bounded completely or almost completely by free surfaces which maintains its shape due to the surface tension of the liquid.</obo1:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>drop</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">droplet</rdfs:label>
    </owl:Class>
