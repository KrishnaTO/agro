# Class: <http://purl.obolibrary.org/obo/ENVO_01000649> (trench)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Trench") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000649> "A trench is a type of excavation or depression in the ground that is generally deeper than it is wide (as opposed to a wider gully or ditch), and narrow compared to its length (as opposed to a simple hole).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_01000649> "EcoLexicon:trench")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_01000649> "SWEETRealm:Trench")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000649> "trench"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000649> <http://purl.obolibrary.org/obo/ENVO_00000309>)

