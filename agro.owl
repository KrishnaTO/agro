    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000267"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Measure the lignin concentration with the thioglycolic acid method.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://naldc.nal.usda.gov/download/3268/PDF</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/pubmed/12564795</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000264"/>
        <obo1:IAO_0000115 xml:lang="en">Measure the lignin concentration with the Klason method.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">lignin concentration measurement Klason protocol</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000268"/>
