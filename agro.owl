            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inorganic sulfate salt obtained by reaction of sulfuric acid with two equivalents of ammonia. A high-melting (decomposes above 280degreeC) white solid which is very soluble in water (70.6 g/100 g water at 0degreeC; 103.8 g/100 g water at 100degreeC), it is widely used as a fertilizer for alkaline soils.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diazanium sulfate</oboInOwl:hasExactSynonym>
