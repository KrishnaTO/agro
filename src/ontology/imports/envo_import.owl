# Class: <http://purl.obolibrary.org/obo/ENVO_01001442> (agriculture)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Agriculture") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001442> "A land use process during which terrestrial environments are modified such that they can grow crop plants or allow the rearing of animals to provide food, fiber, medicines, or other products used by humans.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001442> "\"Agriculture includes horticulture, fruit growing, seed growing, dairy farming, the breeding and keeping of livestock (including any creature kept for the production of food, wool, skins or fur), the use of land as grazing land, meadow land, osier land, market gardens and nursery grounds, and the use of woodlands where that use is ancillary to the farming of land for other agricultural purposes.\"")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001442> "agriculture"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001442> <http://purl.obolibrary.org/obo/ENVO_01001431>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001450> (usage of an environment for industry)

