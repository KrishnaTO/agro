            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000111 xml:lang="en">statistical analysis section</obo1:IAO_0000111>
        <obo1:IAO_0000112 xml:lang="en">The section labelled &apos;statistical analysis&apos; in a typical scientific journal article, e.g. Mondo et al. Cardiovasc J Afr. 2013 Mar; 24(2): 28–33. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3734881/)</obo1:IAO_0000112>
        <obo1:IAO_0000115 xml:lang="en">A part of the document used to describe the statistical methodologies employed in the work presented in the document.</obo1:IAO_0000115>
        <obo1:IAO_0000117 xml:lang="en">PERSON: Bill Baumgartner</obo1:IAO_0000117>
        <obo1:IAO_0000118 xml:lang="en">statistical analysis</obo1:IAO_0000118>
