        </rdfs:subClassOf>
        <obo1:IAO_0000111 xml:lang="en">document part</obo1:IAO_0000111>
        <obo1:IAO_0000112 xml:lang="en">An abstract, introduction, method or results section.</obo1:IAO_0000112>
        <obo1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo1:IAO_0000115 xml:lang="en">An information content entity that is part of a document.</obo1:IAO_0000115>
