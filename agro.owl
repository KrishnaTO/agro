            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115 xml:lang="en">An agricultural environmental material that contains ground-biomass remaining after pressing oil seeds.</obo1:IAO_0000115>
        <rdfs:comment xml:lang="en">ground oil cake</rdfs:comment>
        <rdfs:label xml:lang="en">oil meal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000089 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000089">
