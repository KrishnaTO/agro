    <!-- http://purl.obolibrary.org/obo/FOODON_00001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400361"/>
        <obo1:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A substance, usually composed primarily of carbohydrates, fats, water and/or proteins, that can be eaten or drunk by an animal or human being for nutrition or pleasure.</obo1:IAO_0000115>
        <obo1:IAO_0000115 xml:lang="en">Food material for humans and animals which is processed with the intention that it be consumable as a whole or added to other food products.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">food product</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foodon product type</rdfs:label>
    </owl:Class>
    


