        <oboInOwl:hasDbXref>https://www.marksclearing.com/5-popular-land-clearing-techniques/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000525"/>
