                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000832"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A hydrological precipitation process in which atmospheric water vapour condenses to form droplets of liquid water massive enough to fall to a planetary surface due to the planet&apos;s gravity.</obo1:IAO_0000115>
        <oboInOwl:hasBroadSynonym>rain fall</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>rainfall</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasRelatedSynonym>rain</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">water-based rainfall</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hydrological precipitation process in which atmospheric water vapour condenses to form droplets of liquid water massive enough to fall to a planetary surface due to the planet&apos;s gravity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Rain</oboInOwl:hasDbXref>
    </owl:Axiom>
    


