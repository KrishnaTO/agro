        <obo1:IAO_0000115 xml:lang="en">A text based digital entity is a digital entity that is encoded so that it only contains text characters.</obo1:IAO_0000115>
        <obo1:IAO_0000116 xml:lang="en">3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4
superclass was &apos;digital document&apos;</obo1:IAO_0000116>
        <obo1:IAO_0000116 xml:lang="en">digital_entity</obo1:IAO_0000116>
        <obo1:IAO_0000117 xml:lang="en">person:Chris Stoeckert</obo1:IAO_0000117>
