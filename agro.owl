        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An anthropogenic terrestrial biome is a terrestrial biome which has community structures determined by human activity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.eoearth.org/view/article/150128/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


