    <!-- http://purl.obolibrary.org/obo/ENVO_01000798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000140"/>
        <obo1:IAO_0000115>A material entity which is composed of a volume of unbound positive and negative particles in roughly equal numbers, conducts electricity, and possesses internal magnetic fields.</obo1:IAO_0000115>
        <rdfs:label xml:lang="en">plasma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
