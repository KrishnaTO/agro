        <oboInOwl:hasExactSynonym>parcel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plot</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">agricultural experimental plot</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/AGRO_00000301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A site within which an agricultural experimental process is conducted</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.fao.org/wairdocs/ilri/x5546e/x5546e0a.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/AGRO_00000302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AGRO_00000302">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
