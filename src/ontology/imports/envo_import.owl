# Class: <http://purl.obolibrary.org/obo/ENVO_01000048> (ocean biome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ORCID:0000-0002-4366-3088") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Ocean") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000048> "A marine biome which is determined by an ocean.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000048> <http://purl.obolibrary.org/obo/ENVO_03605017>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000048> <http://purl.obolibrary.org/obo/envo#envoPolar>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000048> "Ocean biomes are determined by major bodies of saline water, principal components of the hydrosphere. Approximately 71% of the Earth's surface is covered by ocean, a continuous body of water that is customarily divided into several principal oceans and smaller seas. More than half of this area is over 3,000 metres (9,800 ft) deep. Average oceanic salinity is around 35 parts per thousand (ppt) (3.5%), and nearly all seawater has a salinity in the range of 30 to 38 ppt.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000048> "ocean biome")
