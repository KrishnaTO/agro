SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000261> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01001245>))

